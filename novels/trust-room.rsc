1:["$","main",null,{"className":"novel-detail novel-detail-landscape","children":[["$","div",null,{"className":"novel-detail-atmosphere","aria-hidden":"true"}],["$","header",null,{"className":"detail-header","children":[["$","a",null,{"className":"brand","href":"../../","aria-label":"縫牢街の入口へ戻る","children":["縫牢街",["$","span",null,{"children":"HŌRŌGAI"}]]}],["$","a",null,{"className":"detail-back","href":"../../novels/","children":[["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":17}]," 小説一覧へ戻る"]}]]}],[["$","nav",null,{"className":"breadcrumbs","aria-label":"パンくずリスト","children":[["$","a",null,{"href":"../../","children":"縫牢街"}],["$","span",null,{"aria-hidden":"true","children":" / "}],[["$","a",null,{"href":"../../novels/","children":"小説一覧"}],["$","span",null,{"aria-hidden":"true","children":" / "}],["$","span",null,{"aria-current":"page","children":"TRUST ROOM"}]]]}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"縫牢街\",\"item\":\"https://nuimaayato.github.io/nuimaayato/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"小説一覧\",\"item\":\"https://nuimaayato.github.io/nuimaayato/novels/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"TRUST ROOM\"}]}"}}]],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"CreativeWork\",\"name\":\"TRUST ROOM\",\"url\":\"https://nuimaayato.github.io/nuimaayato/novels/trust-room/\",\"image\":\"https://nuimaayato.github.io/nuimaayato/images/novels/trust-room.png\",\"description\":\"結婚して半年の新婚夫婦・今村亮介と真帆。 二人は、一人100万円の報酬が支払われる 「強い信頼関係を持つ二人の共同意思決定研究」へ参加する。 二泊三日を過ごすのは、 透明な一枚の仕切りによって二つに分けられた試験室。 顔は見える。 声も聞こえる。 すぐ隣にいる。 それなのに、触れることだけができない。 そして二人の端末には、 相手には見えない「選択」が表示され始める。 相手が何を見ているのか。 何を選んだのか。 本当のことを話しているのか。 確かめる方法はない。 これは怪物や幽霊の物語ではありません。 一番怖いのは、 信じている人間の心。 そして、 自分自身が何を選ぶのか。 全5話で描く、 …\",\"inLanguage\":\"ja\",\"author\":{\"@type\":\"Person\",\"name\":\"縫魔 妖斗\"},\"sameAs\":\"https://note.com/nuima_ayato132/m/m27f074a9fb39\"}"}}],["$","section",null,{"className":"novel-detail-layout","aria-labelledby":"novel-title","children":[["$","div",null,{"className":"novel-cover-stage","children":["$","div",null,{"className":"novel-cover-frame","children":["$","img",null,{"src":"../../images/novels/trust-room.png","alt":"透明な仕切りで隔てられた冷たい試験室に男女が座り、中央に「TRUST ROOM」と書かれた表紙。","width":1672,"height":941,"fetchPriority":"high"}]}]}],["$","div",null,{"className":"novel-detail-copy","children":[["$","p",null,{"className":"eyebrow","children":"NOVEL — 縫牢街書庫"}],["$","h1",null,{"id":"novel-title","children":"TRUST ROOM"}],"$undefined",["$","p",null,{"children":"心理・人間ホラー"}],["$","span",null,{"className":"novel-completion novel-detail-completion","children":"全5話"}],["$","span",null,{"className":"detail-rule","aria-hidden":"true"}],["$","section",null,{"className":"novel-synopsis","aria-labelledby":"synopsis-title","children":[["$","h2",null,{"id":"synopsis-title","children":"あらすじ"}],["$","p",null,{"children":"結婚して半年の新婚夫婦・今村亮介と真帆。\n\n二人は、一人100万円の報酬が支払われる\n「強い信頼関係を持つ二人の共同意思決定研究」へ参加する。\n\n二泊三日を過ごすのは、\n透明な一枚の仕切りによって二つに分けられた試験室。\n\n顔は見える。\n声も聞こえる。\nすぐ隣にいる。\n\nそれなのに、触れることだけができない。\n\nそして二人の端末には、\n相手には見えない「選択」が表示され始める。\n\n相手が何を見ているのか。\n何を選んだのか。\n本当のことを話しているのか。\n\n確かめる方法はない。\n\nこれは怪物や幽霊の物語ではありません。\n\n一番怖いのは、\n信じている人間の心。\n\nそして、\n自分自身が何を選ぶのか。\n\n全5話で描く、\n心理サスペンス・人間ホラー。\n\n各話の最後には、\n物語を読んでいる“あなた自身”への問いがあります。\n\n最後に試されるのは、\nこの部屋にいる二人だけではありません。"}]]}],["$","a",null,{"className":"novel-read-button","href":"https://note.com/nuima_ayato132/m/m27f074a9fb39","target":"_blank","rel":"noopener noreferrer","children":["『","TRUST ROOM","』をnoteで読む ",["$","$Ld",null,{"ref":"$undefined","iconNode":[["path",{"d":"M7 7h10v10","key":"1tivn9"}],["path",{"d":"M7 17 17 7","key":"1vkiza"}]],"className":"lucide-arrow-up-right","size":20}],["$","span",null,{"className":"sr-only","children":"（note・新しいタブ）"}]]}],["$","p",null,{"className":"external-note","children":"noteで開きます"}],false]}]]}]]}]
